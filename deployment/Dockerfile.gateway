FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BANDI_MODE=gateway PORT=8080
WORKDIR /app
COPY supabase-root-2021.crt /usr/local/share/ca-certificates/supabase-root-2021.crt
RUN update-ca-certificates
COPY requirements-gateway.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-gateway.txt \
    && useradd --uid 1001 --no-create-home --shell /usr/sbin/nologin app
COPY --chown=1001:1001 apps ./apps
USER 1001:1001
EXPOSE 8080
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
