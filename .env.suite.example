# Backend only. This file is a template, never put peer keys in VITE_* variables.
# Inject these environment variables into the Java backend; Spring does not load
# this file automatically. Keep local copies in .env.suite.local (gitignored).
SUITE_ENABLED=false
SUITE_ORGANIZATION_ID=
SUITE_ASSOCIATION_ID=
SUITE_LIBREPM_API_URL=https://librepm-backend.example.org
SUITE_ASSOCIAGO_KEY=
SUITE_HTTP_TIMEOUT_SECONDS=15
# Set the same organization UUID and AssociaGo pair key in LibrePM.
# LibrePM owns all three public URLs used to build navigation links.
# Existing Clerk, database and application configuration remains required.
# Optional public frontend setting, coherent with the installation association:
# VITE_ASSOCIATION_ID=1
