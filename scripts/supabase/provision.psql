-- Run once with psql as the dedicated project's administrative database role.
-- This is provisioning, not an application migration. Never run on a shared
-- project without reviewing names and privileges. It refuses existing targets.
\set ON_ERROR_STOP on
\getenv associago_owner_password SUPABASE_ASSOCIAGO_OWNER_PASSWORD
\getenv associago_app_password SUPABASE_ASSOCIAGO_APP_PASSWORD
\getenv librepm_owner_password SUPABASE_LIBREPM_OWNER_PASSWORD
\getenv librepm_app_password SUPABASE_LIBREPM_APP_PASSWORD
\getenv bandi_owner_password SUPABASE_BANDI_OWNER_PASSWORD
\getenv bandi_app_password SUPABASE_BANDI_APP_PASSWORD

BEGIN;
SELECT length(:'associago_owner_password') >= 32
   AND length(:'associago_app_password') >= 32
   AND length(:'librepm_owner_password') >= 32
   AND length(:'librepm_app_password') >= 32
   AND length(:'bandi_owner_password') >= 32
   AND length(:'bandi_app_password') >= 32
   AND (SELECT count(DISTINCT password) FROM (VALUES
       (:'associago_owner_password'), (:'associago_app_password'),
       (:'librepm_owner_password'), (:'librepm_app_password'),
       (:'bandi_owner_password'), (:'bandi_app_password')) AS supplied(password)) = 6
   AS passwords_valid \gset
\if :passwords_valid
\else
    DO $password_error$
    BEGIN
        RAISE EXCEPTION 'Six distinct database passwords of at least 32 characters are required.';
    END
    $password_error$;
\endif

DO $checks$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_class relation JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
               WHERE namespace.nspname = 'public' AND relation.relkind IN ('r', 'p', 'v', 'm', 'S')) THEN
        RAISE EXCEPTION 'The public schema contains existing objects. Use a dedicated empty Supabase project.';
    END IF;
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname IN
        ('associago_owner', 'associago_app', 'librepm_owner', 'librepm_app', 'bandi_owner', 'bandi_app'))
       OR EXISTS (SELECT 1 FROM pg_namespace WHERE nspname IN ('associago', 'librepm', 'bandi')) THEN
        RAISE EXCEPTION 'A target schema or application role already exists. No existing objects were changed.';
    END IF;
END
$checks$;

CREATE ROLE associago_owner LOGIN PASSWORD :'associago_owner_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE associago_app LOGIN PASSWORD :'associago_app_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE librepm_owner LOGIN PASSWORD :'librepm_owner_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE librepm_app LOGIN PASSWORD :'librepm_app_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE bandi_owner LOGIN PASSWORD :'bandi_owner_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
CREATE ROLE bandi_app LOGIN PASSWORD :'bandi_app_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS;
GRANT associago_owner, librepm_owner, bandi_owner TO CURRENT_USER;

CREATE SCHEMA associago AUTHORIZATION associago_owner;
CREATE SCHEMA librepm AUTHORIZATION librepm_owner;
CREATE SCHEMA bandi AUTHORIZATION bandi_owner;
CREATE SCHEMA IF NOT EXISTS extensions;
CREATE EXTENSION IF NOT EXISTS vector WITH SCHEMA extensions;
DO $extension_location$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_extension extension
                   JOIN pg_namespace namespace ON namespace.oid = extension.extnamespace
                   WHERE extension.extname = 'vector' AND namespace.nspname = 'extensions') THEN
        RAISE EXCEPTION 'The vector extension must be installed in the extensions schema before migrating Bandi.';
    END IF;
END
$extension_location$;

REVOKE ALL ON SCHEMA associago, librepm, bandi FROM PUBLIC;
-- Supabase built-in roles exist in hosted projects, not plain PostgreSQL.
DO $api_roles$
DECLARE api_role text;
BEGIN
    FOREACH api_role IN ARRAY ARRAY['anon', 'authenticated', 'service_role'] LOOP
        IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = api_role) THEN
            EXECUTE format('REVOKE ALL ON SCHEMA associago, librepm, bandi FROM %I', api_role);
        END IF;
    END LOOP;
END
$api_roles$;

GRANT USAGE ON SCHEMA associago TO associago_app;
GRANT USAGE ON SCHEMA librepm TO librepm_app;
GRANT USAGE ON SCHEMA bandi TO bandi_app;
GRANT USAGE ON SCHEMA extensions TO associago_owner, associago_app, librepm_owner, librepm_app, bandi_owner, bandi_app;

ALTER DEFAULT PRIVILEGES FOR ROLE associago_owner IN SCHEMA associago GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO associago_app;
ALTER DEFAULT PRIVILEGES FOR ROLE associago_owner IN SCHEMA associago GRANT USAGE, SELECT ON SEQUENCES TO associago_app;
ALTER DEFAULT PRIVILEGES FOR ROLE associago_owner REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE librepm_owner IN SCHEMA librepm GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO librepm_app;
ALTER DEFAULT PRIVILEGES FOR ROLE librepm_owner IN SCHEMA librepm GRANT USAGE, SELECT ON SEQUENCES TO librepm_app;
ALTER DEFAULT PRIVILEGES FOR ROLE librepm_owner REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE bandi_owner IN SCHEMA bandi GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO bandi_app;
ALTER DEFAULT PRIVILEGES FOR ROLE bandi_owner IN SCHEMA bandi GRANT USAGE, SELECT ON SEQUENCES TO bandi_app;
ALTER DEFAULT PRIVILEGES FOR ROLE bandi_owner REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;

ALTER ROLE associago_owner SET search_path TO associago, extensions;
ALTER ROLE associago_app SET search_path TO associago, extensions;
ALTER ROLE librepm_owner SET search_path TO librepm, extensions;
ALTER ROLE librepm_app SET search_path TO librepm, extensions;
ALTER ROLE bandi_owner SET search_path TO bandi, extensions;
ALTER ROLE bandi_app SET search_path TO bandi, extensions;
COMMIT;

-- Keep these schemas OUT of Supabase Data API "Exposed schemas".
-- Migrations connect as *_owner; application queries connect as *_app.
