# Backend-only template: Spring reads process environment, not this file.
# Private schema and existing Clerk authorization. No real credentials here.
SPRING_PROFILES_ACTIVE=cloud-postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
SPRING_DATASOURCE_USERNAME=associago_app
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_URL=jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
SPRING_FLYWAY_USER=associago_owner
SPRING_FLYWAY_PASSWORD=
# Copy endpoint and usernames from Connect. Session pooler usernames include
# the project suffix; do not infer them from the direct connection example.
DB_POOL_MAX=3
DB_POOL_MIN=0
CLERK_ISSUER_URI=
CLERK_AUDIENCE=
CORS_ALLOWED_ORIGINS=
SUITE_ENABLED=false
# Add the existing suite variables from .env.suite.example when initialized.
# Never use a database password or service_role key in VITE_* variables.
